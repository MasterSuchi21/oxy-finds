# Your Kakobuy affiliate code. Every outbound product link is built with this.
AFFCODE=brmrb

# Mongo connection string. Leave unset for local dev and the server will spin up
# an in-memory MongoDB automatically (data is lost on restart — run `npm run seed`).
# Production example (Atlas):
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/kakubuy?retryWrites=true&w=majority
MONGODB_URI=

PORT=4000

# Comma-separated list of allowed browser origins for the API.
CORS_ORIGIN=http://localhost:5173
